{
  "name": "roku-flightlane-self-hosted",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted local service and Roku app for Flight Lane.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "api": "node server/server.mjs",
    "serve": "node scripts/supervise.mjs",
    "build": "node scripts/build.mjs",
    "build:screensaver": "node scripts/build.mjs --screensaver",
    "deploy": "node scripts/deploy.mjs",
    "debug": "node scripts/debug.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "check": "node scripts/validate.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "brighterscript": "0.73.0"
  }
}
