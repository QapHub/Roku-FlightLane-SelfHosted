# Copy this file to .env.local. Never commit .env.local.
#
# Roku app build settings
APP_NAME=Flight Lane
FLIGHTLANE_API_URL=http://192.168.1.100:8787
ROKU_DEVICE_IP=192.168.1.50
RADIUS_MILES=4
REFRESH_SECONDS=15

# Local service settings
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=8787
LOCAL_NETWORK_ONLY=true
PROVIDER_TIMEOUT_MS=10000

# Live aircraft provider
# The local service tries this first, then falls back to ADSB.lol and ADSB.fi.
AIRCRAFT_API_BASE_URL=https://api.adsb.lol/v2
AIRCRAFT_CACHE_SECONDS=15

# Every provider below is free and needs no account or key.
# Address lookup: US Census Bureau geocoder (US street addresses only).
# Satellite maps: public-domain USDA/USGS imagery from The National Map (US coverage).
# Map images are kept in memory to avoid repeat provider calls (0 disables reuse).
MAP_CACHE_SECONDS=86400

# Flight route enrichment from adsbdb.com (optional)
ENABLE_FLIGHT_ROUTES=true
FLIGHT_DETAILS_CACHE_SECONDS=86400

# Live flight status and times from FlightAware AeroAPI (optional, BILLED per query).
# Blank key: routes come from free adsbdb.com and nothing is sent to FlightAware.
# With a key: FlightAware is preferred for every route lookup, falling back to adsbdb.com
# when the spend limit is reached, usage cannot be read, or FlightAware has no match.
FLIGHTAWARE_API_KEY=
# Month-to-date AeroAPI spend in US dollars (all keys on the account), read from
# FlightAware's free usage endpoint. Defaults: warning at $5, billed lookups stop at $10.
FLIGHTAWARE_API_SPEND_WARNING=5
FLIGHTAWARE_API_SPEND_LIMIT=10
# Minutes to reuse a callsign's FlightAware result. Default: 1440 (24 hours).
FLIGHTAWARE_CACHE_TTL=1440
# Backstop on billed lookups per UTC day, between 10-minute usage readings. Default: 500.
FLIGHTAWARE_DAILY_LIMIT=500

# Aircraft photos (optional; no key is currently required)
ENABLE_AIRCRAFT_PHOTOS=true
AIRCRAFT_PHOTO_CACHE_SECONDS=3600
